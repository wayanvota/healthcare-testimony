{
  "name": "healthcare-ceo-senate-testimony-alignment-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone healthcare-focused Senate testimony alignment tool.",
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test test/e2e",
    "test:ci": "npm test && npm run test:e2e",
    "test:live:openai": "node test/live/openai-live-smoke.mjs",
    "test:live": "playwright test --config=playwright.live.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
